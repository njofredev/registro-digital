generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model registros {
  identificador   Int     @id
  asunto_detalles String?
  bloques_usados  String?
  diseno          String?
  doctor          String?
  estado          String?
  fecha_diseno    String?
  fecha_fresado   String?
  fecha_ingreso   String?
  fecha_entrega   String?
  material        String?
  nombre_paciente String?
  sucursal        String?
  tons_a_cargo    String?
  piezas          String?
}

model radiologia {
  id                     Int     @id @default(autoincrement())
  rut                    String?
  nombre                 String?
  apellido_paterno       String?
  apellido_materno       String?
  edad                   Int?
  fecha_nacimiento       String?
  doctor                 String?
  especialidad           String?
  dg_clinico             String?
  sucursal               String?
  observaciones          String?
  fecha_toma_examen      String?
  observaciones_operador String?
  rx_panoramica          Int?
  analisis_cefalometrico Int?
  teleradiografia        Int?
  tomografia_atm         Int?
  tomografia_grupo_pieza Int?
  tomografia_arcada      Int?
  tomografia_total       Int?
  rx_retroalveolar_total Int?
  rx_mano                Int?
  bitewing_bilateral     Int?
  fecha_entrega          String?
  radiologo_responsable  String?
  proceso                String?
  correo                 String?
}

model derivaciones {
  identificador   Int     @id
  asunto_detalles String?
  bloques_usados  String?
  diseno          String?
  doctor          String?
  estado          String?
  fecha_diseno    String?
  fecha_fresado   String?
  fecha_ingreso   String?
  fecha_entrega   String?
  material        String?
  nombre_paciente String?
  sucursal        String?
  tons_a_cargo    String?
  piezas          String?
}

model radiologia_derivaciones {
  id                     Int     @id @default(autoincrement())
  rut                    String?
  nombre                 String?
  apellido_paterno       String?
  apellido_materno       String?
  edad                   Int?
  fecha_nacimiento       String?
  doctor                 String?
  especialidad           String?
  dg_clinico             String?
  sucursal               String?
  observaciones          String?
  fecha_toma_examen      String?
  observaciones_operador String?
  rx_panoramica          Int?
  analisis_cefalometrico Int?
  teleradiografia        Int?
  tomografia_atm         Int?
  tomografia_grupo_pieza Int?
  tomografia_arcada      Int?
  tomografia_total       Int?
  rx_retroalveolar_total Int?
  rx_mano                Int?
  bitewing_bilateral     Int?
  fecha_entrega          String?
  radiologo_responsable  String?
  proceso                String?
  correo                 String?
}

